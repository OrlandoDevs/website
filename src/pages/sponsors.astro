---
import MainLayout from "../layouts/MainLayout.astro";
import SponsorList from "../components/SponsorList.astro";
import { fade } from "astro:transitions";
---

<MainLayout title="Sponsors">
  <div
    class="p-6 mb-7 text-slate-300 text-xl mx-6"
    transition:animate={fade({ duration: "0.4s" })}
  >
    <h1
      class="text-center text-4xl lg:text-5xl border-b-2 border-[#ABA1A1] py-3 bg-gradient-to-r from-cyan-300 to-white text-transparent bg-clip-text"
    >
      Interested In Becoming a Sponsor?
    </h1>
    <p class="text-xl text-slate-100 text-center mt-6">
      Lorem ipsum dolor, sit amet consectetur adipisicing elit. Odit reiciendis
      similique, expedita ex, ipsa architecto quisquam maxime, minus ducimus
      consequatur necessitatibus. Eos ratione culpa maiores mollitia veniam
      animi alias nihil repellendus. At, atque. Unde, exercitationem quibusdam?
      Adipisci, natus voluptate. Natus voluptas atque, amet, minus repellat esse
      blanditiis facere assumenda odio, dolores nulla? Rerum nemo, amet rem, ea
      perferendis fugiat cumque laboriosam eligendi officiis, saepe sapiente
      quas explicabo iure! Blanditiis, nemo iste maxime ipsa consequatur
      doloremque, sequi officia aliquid incidunt harum repellat optio sed nam
      provident magnam magni aliquam doloribus excepturi est adipisci unde
      maiores odio ab alias! Ex suscipit, corrupti mollitia perferendis
      explicabo accusantium nesciunt deserunt soluta? Vero obcaecati ipsam dicta
      placeat reiciendis blanditiis, vel similique quae quam voluptates quasi ab
      quibusdam tempore ratione voluptatum praesentium, amet, voluptatem labore
      odio rem numquam nobis. Sunt nemo quas incidunt rem? A natus maiores
      voluptatem beatae aliquid earum sapiente explicabo sequi eius distinctio.
    </p>
    <h2
      class="text-center text-3xl lg:text-4xl mt-10 bg-gradient-to-r from-cyan-300 to-white text-transparent bg-clip-text"
    >
      Our Current Sponsors:
    </h2>
    <div class="flex flex-col gap-y-8 py-10">
      <SponsorList />
    </div>
  </div>
</MainLayout>
