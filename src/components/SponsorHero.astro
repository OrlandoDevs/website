---
import { shuffleArray } from "../utils/shuffleArray";
import sponsorData from "../data/sponsors.json";
import type SponsorProps from "../interfaces/SponsorInterfaces";
const sponsors: SponsorProps[] = sponsorData.sponsors;
const sortedSponsors = sponsors.slice().sort((a, b) => a.id - b.id);
const sponsorCount = sortedSponsors.length;
---

<div class="py-8 relative lg:my-16">
  <h2
    class="text-center text-3xl lg:text-4xl border-b border-[#ABA1A1] py-2 bg-gradient-to-r from-cyan-300 to-white text-transparent bg-clip-text mt-4 font-bold mb-6"
  >
    Our Current Sponsors:
  </h2>
  <div class="flex flex-col gap-y-4 py-6 items-center">
    <div
      class="grid grid-cols-[150px_150px] gap-4 lg:grid-cols-[200px_200px_200px] lg:grid-rows-[200px_200px_200px] justify-center justify-items-stretch items-stretch w-full"
    >
      {
        sortedSponsors.map((sponsor, idx) => {
          // Center the last row if 7 or 8 sponsors
          let extraClass = "";
          if (sponsorCount === 7 && idx === 6) {
            extraClass = "lg:col-start-2";
          } else if (sponsorCount === 8 && (idx === 6 || idx === 7)) {
            extraClass = "col-span-1 lg:col-start-2";
          }
          return (
            <div
              data-id={sponsor.id}
              class={`rounded-xl bg-white shadow-xl shadow-slate-700 flex flex-col items-center justify-center p-4 ${extraClass}`}
            >
              <a href={sponsor.link} target="_blank" class="relative block group w-full h-full">
                <div class="absolute inset-0 flex flex-col items-center justify-center text-black text-base font-medium opacity-0 transition-opacity group-hover:opacity-100 z-10 duration-500 ease-in-out px-4 text-center pointer-events-none">
                  <span class="text-lg font-bold mb-2">{sponsor.name}</span>
                  <span class="text-xs leading-snug">{sponsor.description}</span>
                </div>
                <figure class="px-3 py-3 flex items-center justify-center">
                  <img
                    src={sponsor.image}
                    alt={sponsor.name}
                    class="object-contain w-full h-40 transition-all group-hover:filter group-hover:grayscale-[70%] group-hover:blur-xl duration-700"
                  />
                </figure>
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
</div>
