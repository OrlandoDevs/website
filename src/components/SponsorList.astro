---
import sponsorData from "../data/sponsors.json";
import type SponsorProps from "../interfaces/SponsorInterfaces";
const sponsors: SponsorProps[] = sponsorData.sponsors;

const sponsorsById = [...sponsors].sort((a, b) => a.id - b.id);
---

<div
  class="grid grid-cols-[150px_150px] gap-5 lg:grid-cols-[200px_200px_200px] lg:grid-rows-[200px_200px_200px] justify-center justify-items-stretch items-stretch"
>
  {
    sponsorsById.map((sponsor, idx) => {
      // If there are 7 sponsors and this is the last one, add a blank after it for centering
      if (sponsorsById.length === 7 && idx === 6) {
        return [
          <div
            data-id={sponsor.id}
            class="rounded-xl bg-slate-200 shadow-xl shadow-slate-700 lg:col-start-2"
          >
            <a href={sponsor.link} target="_blank" class="relative block group">
              <p class="absolute inset-0 flex items-center justify-center text-black text-sm font-normal opacity-0 transition-opacity group-hover:opacity-100 z-10 duration-700 ease-in-out px-4 text-center">
                {sponsor.description}
              </p>
              <figure class="px-3 py-3">
                <img
                  src={sponsor.image}
                  alt={sponsor.name}
                  class="object-contain w-full h-40 transition-all group-hover:filter group-hover:grayscale-[70%] group-hover:blur-xl duration-700"
                />
              </figure>
            </a>
          </div>,
          <div class="hidden lg:block"></div>
        ];
      }
      return (
        <div
          data-id={sponsor.id}
          class="rounded-xl bg-white shadow-xl shadow-slate-700"
        >
          <a href={sponsor.link} target="_blank" class="relative block group">
            <p class="absolute inset-0 flex items-center justify-center text-black text-sm font-normal opacity-0 transition-opacity group-hover:opacity-100 z-10 duration-700 ease-in-out px-4 text-center">
              {sponsor.description}
            </p>
            <figure class="px-3 py-3">
              <img
                src={sponsor.image}
                alt={sponsor.name}
                class="object-contain w-full h-40 transition-all group-hover:filter group-hover:grayscale-[70%] group-hover:blur-xl duration-700"
              />
            </figure>
          </a>
        </div>
      );
    })
  }
</div>
